{
  "name": "dropit-dj-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready DJ library analysis and set planning copilot",
  "author": "itoyohane",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8765 --reload",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8765",
    "test": "python -m pytest backend/tests -q -p no:cacheprovider"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  }
}
